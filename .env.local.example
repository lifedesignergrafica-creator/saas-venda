# Google OAuth Client ID (Web application) — required para o PDV/login do lojista.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 (and your production URL)
# Enable the Google Drive API and the appdata scope in your OAuth consent screen.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---------- Loja Online (Supabase) ----------
# Crie um projeto em https://supabase.com, rode supabase/schema.sql no SQL Editor,
# e copie as chaves em Project Settings > API.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secreta — nunca expor no navegador
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key       # pública — usada só para leitura do catálogo

# Slug da loja usada no painel /dashboard/orders (deve bater com stores.slug no banco)
NEXT_PUBLIC_STORE_SLUG=minha-loja

# ---------- Pagamento (Mercado Pago) ----------
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token

# URL pública do site (usada nas back_urls e no webhook do Mercado Pago).
# Em produção, use o domínio real (ex: https://sualoja.com.br).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------- E-mail transacional (Resend) ----------
# Crie uma conta gratuita em https://resend.com e gere uma API key.
RESEND_API_KEY=your-resend-api-key
# Endereço de envio. Sem domínio verificado, use o padrão de testes do Resend:
EMAIL_FROM="SaaS Venda <onboarding@resend.dev>"
